<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Panel Administrador - Gestión de Usuarios"
        android:textColor="#0F172A"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:text="Toca un usuario para editarlo o mantén presionado para eliminarlo"
        android:textColor="#64748B"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnCrearUsuarioAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ Crear Nuevo Usuario" />

    <ListView
        android:id="@+id/lvUsuariosAdmin"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginVertical="12dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:divider="#E2E8F0"
        android:dividerHeight="1dp" />

    <Button
        android:id="@+id/btnCerrarSesionAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#DC2626"
        android:text="Cerrar Sesión"
        android:textColor="#FFFFFF" />

</LinearLayout>
